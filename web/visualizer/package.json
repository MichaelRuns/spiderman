{
  "name": "@spiderman/visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub-Pages-deployed inference visualizer: real autoregressive generation with @spiderman/nn, KV cache, and per-layer activations exposed as graphically as possible.",
  "scripts": {
    "predev": "node scripts/copy-weights.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-weights.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@spiderman/nn": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
