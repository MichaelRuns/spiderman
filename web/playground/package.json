{
  "name": "@spiderman/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone, graphical explainers for individual model modules (BPE, RoPE, attention) using the real @spiderman/nn math on tiny, fully-visible tensors \u2014 independent of running the full model.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@spiderman/nn": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
